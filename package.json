{
  "name": "pigeon-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "bin": {
    "pigeon": "dist/pigeon.mjs"
  },
  "files": [
    "dist/pigeon.mjs",
    "dist/pigeon-cli.mjs",
    "dist/pigeon-cli.mjs.map",
    "docker/"
  ],
  "engines": {
    "node": ">=22.19.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "bundle": "node scripts/build-bundle.mjs",
    "prepare": "npm run bundle",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs fast",
    "test:slow": "node scripts/run-tests.mjs slow",
    "coverage": "node scripts/run-tests.mjs all --coverage.enabled",
    "bench": "vitest bench --run --no-file-parallelism",
    "lint": "biome check .",
    "deps": "dependency-cruiser src",
    "verify": "npm run lint && npm run check && npm run test && npm run deps",
    "verify:full": "npm run lint && npm run check && node scripts/run-tests.mjs all && npm run deps"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vscode/ripgrep": "1.18.0",
    "turndown": "7.2.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@modelcontextprotocol/server-everything": "2026.8.31",
    "@modelcontextprotocol/server-filesystem": "2026.8.31",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.2.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@anthropic-ai/sdk": "0.124.0"
  }
}
